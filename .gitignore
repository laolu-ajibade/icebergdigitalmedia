# ==========================================
# Iceberg Web — Production .gitignore
# Excludes local dev, build caches, secrets,
# editor configs, and agent artifacts from deploy.
# ==========================================

# Dependencies
/node_modules
/.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# Next.js Build & Static Outputs
/.next/
/out/
/build/
/dist/

# Environment Variables & Secrets (Keep confidential, set in hosting dashboard)
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local

# Debug & Runtime Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Caches & Deployment Tooling
.cache/
.turbo/
.vercel/

# OS Metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE & Editor Settings
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Testing & Coverage Reports
coverage/
.nyc_output/

# TypeScript Build Artifacts
*.tsbuildinfo
next-env.d.ts

# Local Agent Workspace & Scratch Artifacts (Not needed in production)
.agents/
.agent/
.gemini/
skills-lock.json
plan.md

# Monorepo / Subproject lockfile override (parent directory manages root lockfile)
package-lock.json
