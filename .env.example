# Iceberg Creative Print Studio Configuration Template

# Admin Password Change Secret Slug Key (used to authorize password changes via API)
ADMIN_PASSWORD_SLUG_KEY=iceberg-secure-slug-key-2026

# JWT Authentication Secret
JWT_SECRET=iceberg-studio-secret-key-2026-commercial-print

# Compulsory MongoDB Connection String
MONGODB_URI=mongodb://localhost:27017/iceberg_print_studio

# Cloudflare R2 Storage Credentials
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
R2_BUCKET=digitalstudio
R2_PUBLIC_URL=https://pub-<hash>.r2.dev
NEXT_PUBLIC_R2_URL=https://pub-<hash>.r2.dev

# Google Business / Places API Credentials (for live Google Reviews & Maps integration)
# GOOGLE_PLACE_ID=CWhgADsBIJ2QEBM
GOOGLE_PLACE_ID=ChIJ....
GOOGLE_API_KEY=AIza....
